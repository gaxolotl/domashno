# ---- Domashno configuration ----
# Copy this file to ".env" and fill in the values.

# Where the server listens
PORT=8787

# Public URL of the app (used for OAuth redirects and cookies).
# In development the Vite dev server is on 5173; the API lives on 8787.
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:8787

# Secret used to sign cookies. Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- OAuth providers (optional) ----
# Create apps at https://console.cloud.google.com/apis/credentials (Google)
# and https://github.com/settings/developers (GitHub).
# Redirect/callback URLs:
#   GOOGLE: ${SERVER_URL}/api/auth/google/callback
#   GITHUB: ${SERVER_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Login without OAuth (name + email only). Handy for local testing.
# Set to 0 to hide the dev-login endpoint in production.
ADMIN_EMAIL=you@example.com
# Optional: more admins, comma-separated
# ADMIN_EMAILS=other@example.com

ENABLE_DEV_LOGIN=1

# ---- Email (sign-up verification codes) ----
# Recommended: Resend (https://resend.com) — create an API key and paste it here.
# Until a provider is configured, verification codes are printed to the server log.
RESEND_API_KEY=
# Or use any SMTP server instead (nodemailer):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
# The From address shown to users (must be a verified sender/domain with your provider)
EMAIL_FROM="Домашно <onboarding@resend.dev>"

# Max verification emails sent per hour across the whole app (protects your provider quota)
EMAIL_MAX_PER_HOUR=300

# ---- Bot protection (Cloudflare Turnstile) ----
# Shown on the login page. Get free keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both empty to disable (fine for local testing).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact email shown on the Terms + Privacy pages (the data-controller contact).
# Leave empty to show a generic "contact the administrator" note instead.
LEGAL_CONTACT_EMAIL=

# Set to 1 to disable all rate limiting (local testing only)
RATE_LIMIT_DISABLED=0

# Where the SQLite DB and uploads live (default: server/data). Point at a mounted volume in prod.
# DATA_DIR=/var/lib/domashno

# Max upload size per file, in megabytes
MAX_UPLOAD_MB=25
