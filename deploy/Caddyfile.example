# Caddyfile — automatic HTTPS (Let's Encrypt) + reverse proxy to the app.
#
# 1. Point an A record for your domain/subdomain at the VPS IP.
# 2. Edit the address below to your domain.
# 3. sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

domashno.example.com {
	encode gzip

	# Optional: allow larger homework uploads than the app's MAX_UPLOAD_MB
	request_body {
		max_size 30MB
	}

	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
	}
}
