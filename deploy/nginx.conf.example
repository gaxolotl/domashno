# nginx site for Домашно — copy to /etc/nginx/sites-available/domashno
# then:  ln -sf /etc/nginx/sites-available/domashno /etc/nginx/sites-enabled/domashno
#        nginx -t && systemctl reload nginx
# certbot will add the HTTPS (443) block automatically.
#
# After certbot has created the 443 block, consider adding there:
#     add_header Strict-Transport-Security "max-age=31536000" always;
#     add_header X-Frame-Options "SAMEORIGIN" always;
# (HSTS only takes effect over HTTPS; X-Frame-Options blocks clickjacking —
# nothing in the app needs to be iframed.)

server {
    listen 80;
    listen [::]:80;
    server_name domashno.example.com;          # <-- your domain/subdomain

    # allow uploads a bit above the app's MAX_UPLOAD_MB
    client_max_body_size 30m;

    # compression for text assets served by the app
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;
    gzip_min_length 1024;

    # hashed /assets/* files are immutable — cache them for a year
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
