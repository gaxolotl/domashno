# nginx site for Домашно — copy to /etc/nginx/sites-available/domashno
# then:  ln -sf /etc/nginx/sites-available/domashno /etc/nginx/sites-enabled/domashno
#        nginx -t && systemctl reload nginx
# certbot will add the HTTPS (443) block automatically.

server {
    listen 80;
    listen [::]:80;
    server_name domashno.example.com;          # <-- your domain/subdomain

    # allow uploads a bit above the app's MAX_UPLOAD_MB
    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
