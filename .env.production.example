# Copy to ".env" on the server and fill in the values.
# This is the production template.

NODE_ENV=production
PORT=8787

# Your public HTTPS address (Caddy/nginx terminates TLS and proxies to PORT).
# If you serve a subdomain, put it here too as APP_URL.
APP_URL=https://domashno.example.com
SERVER_URL=https://domashno.example.com

# Generate with:  node -e "console.log(require('crypto').randomUUID()+require('crypto').randomUUID())"
SESSION_SECRET=replace-with-a-long-random-string

# ---- OAuth (optional but recommended) ----
# Remember to add the production callback URL in the provider's console:
#   https://domashno.example.com/api/auth/google/callback
#   https://domashno.example.com/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# WARNING: keep this 0 in production — it bypasses email verification.
ENABLE_DEV_LOGIN=0

# ---- Email (required for email sign-in) ----
# Resend (recommended): verify your domain in Resend, then paste the API key.
RESEND_API_KEY=
# Or use SMTP instead:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
# Must be a sender/domain verified with your provider.
EMAIL_FROM="Домашно <noreply@example.com>"

MAX_UPLOAD_MB=25
