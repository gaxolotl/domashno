{
  "name": "domashno",
  "version": "1.0.0",
  "private": true,
  "description": "Class timetable + homework board (PWA). Import a Shkolo PDF timetable, then let your class post homework with files.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaxolotl/domashno.git"
  },
  "homepage": "https://github.com/gaxolotl/domashno#readme",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c \"green,cyan\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "setup": "npm install && npm run build",
    "audit": "npm audit --audit-level=low",
    "test:security": "node scripts/test-dependency-security.mjs && node server/scripts/test-class-features.mjs && node server/scripts/test-admin-members.mjs && node server/scripts/test-upload-security.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "deepmerge": "file:vendor/domashno-deepmerge-safe-1.0.0.tgz"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.4"
    },
    "deepmerge": "$deepmerge"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.25.12": true
  }
}
